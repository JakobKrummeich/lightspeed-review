{
  "name": "lightspeed-review",
  "version": "3.0.0",
  "description": "Semantic diff review with targeted agent feedback",
  "keywords": [
    "code-review",
    "diff",
    "agent",
    "cli",
    "llm",
    "ai-agents",
    "pull-request",
    "review-tool"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Jakob Krummeich",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JakobKrummeich/lightspeed-review.git"
  },
  "bugs": {
    "url": "https://github.com/JakobKrummeich/lightspeed-review/issues"
  },
  "homepage": "https://github.com/JakobKrummeich/lightspeed-review#readme",
  "bin": {
    "lightspeed": "bin/lightspeed.js"
  },
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "prepare": "node scripts/build.ts && node scripts/git-hooks.ts",
    "prepack": "node scripts/build.ts",
    "build": "node scripts/build.ts",
    "build:skill": "node scripts/build-skill.ts",
    "grade:grouping": "node scripts/grade-grouping.ts",
    "judge:grouping": "node scripts/judge-grouping.ts",
    "pretest": "node scripts/build.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "pretest:coverage": "node scripts/build.ts",
    "test:coverage": "node --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=97 --test-coverage-branches=93 --test-coverage-functions=94 --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dup": "jscpd",
    "arch": "depcruise src scripts bin --config .dependency-cruiser.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run lint:css && pnpm run format:check && pnpm run build:skill --check && pnpm run dup && pnpm run arch"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@toon-format/toon": "^4.1.1",
    "axi-sdk-js": "^0.1.12",
    "diff2html": "^3.4.56",
    "highlight.js": "^11.12.0",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "dependency-cruiser": "^18.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "jscpd": "^5.3.2",
    "prettier": "^3.9.8",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
